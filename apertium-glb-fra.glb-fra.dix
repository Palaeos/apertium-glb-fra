<?xml version="1.0" encoding="UTF-8"?>
<dictionary>
   <!-- Define the alphabet below. -->
  <alphabet>aAáÁăảạÆbBcCčdDÐeEéèễệfFgGhHiIíjJkKlLmMnNoOóöớpPqQrRsSšştTŢuUúüưvVwWxXyYzZ</alphabet>

  <sdefs>
    <!-- Define symbol definitions within <sdef> here. -->
    <sdef n="n"               c="Noun"/>
    <sdef n="np"              c="Proper noun"/>
    <sdef n="vblex"           c="Verb, lexical"/>
    <sdef n="vbmod"           c="Modal verb"/>
    <sdef n="vaux"            c="Auxiliary verb"/>
    <sdef n="vbser"           c="'To be' verb"/>
    <sdef n="vbhaver"         c="'To have' verb"/>
    <sdef n="vbpr"           c="Verbal preposition"/>
    <sdef n="cnjsub"          c="Subordinating conjunction"/>
    <sdef n="cnjcoo"          c="Co-ordinating conjunction"/>
    <sdef n="cnjadv"          c="Adverbial conjunction"/>
    <sdef n="pr"              c="Preposition"/>
    <sdef n="adv"             c="Adverb"/>
    <sdef n="ij"              c="Interjection"/>
    <sdef n="adj"             c="Adjective"/>
    <sdef n="prn"             c="Pronoun"/>

    <sdef n="pfx"             c="Prefix"/>
    

    <sdef n="attr"            c="Attributive"/>
    <sdef n="top"             c="Toponym"/>
    <sdef n="ant"             c="Anthroponym"/>
    <sdef n="cog"             c="Cognomen"/>
    <sdef n="org"             c="Organisation"/>
    <sdef n="al"              c="Altres / misc proper nouns"/>

    <sdef n="pers"            c="Personal pronoun"/>
    <sdef n="ref"             c="Reflexive pronoun"/>
    <sdef n="res"             c="Reciprocal pronoun"/>

    <sdef n="tn"             c="Tónico"/>
    <sdef n="pro"             c="Proclitic"/>
    <sdef n="enc"             c="Enclitic"/>
    <sdef n="rel"             c="Relative"/>
    <sdef n="preadv"          c="Pre-adverb"/>

    <sdef n="det"             c="Determiner"/>
    <sdef n="pos"             c="Possessive"/>

    <sdef n="p1"              c="1st person"/>
    <sdef n="p2"              c="2nd person"/>
    <sdef n="p3"              c="3rd person"/>

    <sdef n="nt"              c="Neuter"/>
    <sdef n="ut"              c="Utrum"/>
    <sdef n="f"               c="Feminine"/>
    <sdef n="m"               c="Masculine"/>
    <sdef n="mf"               c="Masculine or Feminine"/>
    <sdef n="un"              c="No gender"/>
    <sdef n="GD"              c="Gender to be determined"/>

    <sdef n="sg"              c="Singular"/>
    <sdef n="du"              c="Dual"/>
    <sdef n="pl"              c="Plural"/>
    <sdef n="sp"              c="Singular / plural"/>

    <sdef n="ind"             c="Indefinite"/>
    <sdef n="def"             c="Definite"/>

    <sdef n="nom"             c="Nominative"/>
    <sdef n="acc"             c="Accusative"/>
    <sdef n="gen"             c="Genitive"/>
    <sdef n="dat"             c="Dative"/>

    <sdef n="obj" 	c="Object"/> 
    <sdef n="dobj" 	c="Direct Object"/>
    <sdef n="iobj" 	c="Indirect Object"/>
    <sdef n="subj" 	c="Subject"/> 

    <sdef n="dem"             c="Demonstrative"/>
    <sdef n="itg"             c="Question word / interrogative"/>
    <sdef n="qnt"             c="Quantifier"/>
    <sdef n="neg"             c="Negative"/>
    <sdef n="emph"            c="Emphatic"/>

    <sdef n="inf"             c="Infinitive"/>
    <sdef n="pres"            c="Present"/>
    <sdef n="imp"             c="Imperative"/>
    <sdef n="pret"            c="Preterite"/>
    <sdef n="past"            c="Past"/>
    <sdef n="fut"             c="Future"/>
    <sdef n="cni"             c="Conditional"/>
    <sdef n="pp"              c="Perfect participle"/>
    <sdef n="pprs"            c="Present participle"/>
    <sdef n="pasv"            c="Passive"/>
    <sdef n="actv"            c="Active voice"/>

    <sdef n="sint"            c="Synthetic (of adjectives)"/>
    <sdef n="pst"             c="Positive"/>
    <sdef n="comp"            c="Comparative"/>
    <sdef n="sup"             c="Superlative"/>

    <sdef n="ord"             c="Ordinal"/>
    <sdef n="acr"             c="Acronym"/>
    <sdef n="unc"             c="Uncountable"/>

    <sdef n="num"             c="Numeral"/>
    <sdef n="sent"            c="Sentence end"/>
    <sdef n="cm"              c="Comma"/>
    <sdef n="apos"            c="Apostrophe"/>
    <sdef n="guio"            c="Dash"/>
    <sdef n="lpar"            c="Left parenthesis"/>
    <sdef n="rpar"            c="Right parenthesis"/>
    <sdef n="lquot"           c="Left quote"/>
    <sdef n="rquot"           c="Right quote"/>

    <sdef n="compound-only-L" c="May only be the left-side of a compound"/>
    <sdef n="compound-R"      c="May be the right-side of a compound, or a full word"/>
  </sdefs>

   <section id="main" type="standard">
      <!-- Define entries within <e> here. -->
      <!-- example:
           <e><p><l>house<s n="n"/></l><r>casa<s n="n"/><s n="f"/></r></p></e>
      -->

      <e><re>[.\?;:!…¿¶]</re><p><l><s n="sent"/></l><r><s n="sent"/></r></p></e>
      <e><re>,</re>          <p><l><s n="cm"/></l>  <r><s n="cm"/></r></p></e>

      

    <!-- Co-ordinating conjunction -->
  <!-- According to http://en.wikipedia.org/wiki/Co-ordinating_conjunction :
       after, although, if, unless, so that, and because  -->

      <e>       <p><l>ji<s n="cnjcoo"/></l>                 <r>et<s n="cnjcoo"/></r></p></e>
      <e>       <p><l>or<s n="cnjcoo"/></l>                 <r>ou<s n="cnjcoo"/></r></p></e>
      <e>       <p><l>mas<s n="cnjcoo"/></l>                 <r>mais<s n="cnjcoo"/></r></p></e>

      <e>       <p><l>kom<s n="cnjcoo"/></l>                  <r>que<s n="cnjadv"/></r></p></e>

      <e>       <p><l>ki<s n="cnjsub"/></l>                 <r>que<s n="cnjsub"/></r></p></e>
      <e>       <p><l>koski<s n="cnjsub"/></l>                 <r>parce que<s n="cnjsub"/></r></p></e>
      <e>       <p><l>jaxaki<s n="cnjsub"/></l>                 <r>dès que<s n="cnjsub"/></r></p></e>

      <e>       <p><l>eger<s n="cnjsub"/></l>                 <r>si<s n="cnjsub"/></r></p></e>
      <e r="RL"><p><l>eger<s n="cnjsub"/></l>                 <r>si<s n="cnjadv"/></r></p></e>


      <e>       <p><l>fe<s n = "pr"/></l>   <r>à<s n = "pr"/></r></p></e>
      <e>       <p><l>de<s n = "pr"/></l>   <r>de<s n = "pr"/></r></p></e>
      <e>       <p><l>tas<s n = "pr"/></l>   <r>pour<s n = "pr"/></r></p></e>

      <e>       <p><l>in<s n = "pr"/></l>   <r>dans<s n = "pr"/></r></p></e>


      <e>       <p><l>ton<s n = "pr"/></l>   <r>avec<s n = "pr"/></r></p></e>
      <e>       <p><l>yon<s n = "pr"/></l>   <r>avec<s n = "pr"/></r></p></e>
      <e>       <p><l>har<s n = "pr"/></l>   <r>avec<s n = "pr"/></r></p></e>

      <e>       <p><l>in<s n = "pr"/></l>   <r>en<s n = "pr"/></r></p></e>
      <e>       <p><l>nenhar<s n = "pr"/></l>   <r>sans<s n = "pr"/></r></p></e>
      <e>       <p><l>fol<s n = "pr"/></l>   <r>suivant<s n = "pr"/></r></p></e>
      <e>       <p><l>fol<s n = "pr"/></l>   <r>selon<s n = "pr"/></r></p></e>
      <e>       <p><l>dur<s n = "pr"/></l>   <r>pendant<s n = "pr"/></r></p></e>

      <e>       <p><l>cel<s n = "pr"/></l>   <r>envers<s n = "pr"/></r></p></e>

      <e>       <p><l>intre<s n = "pr"/></l>   <r>entre<s n = "pr"/></r></p></e>
      <e>       <p><l>anti<s n = "pr"/></l>   <r>contre<s n = "pr"/></r></p></e>

      <e>       <p><l>lefe<s n = "pr"/></l>   <r>avant<s n = "pr"/></r></p></e>
      <e>       <p><l>xafe<s n = "pr"/></l>   <r>après<s n = "pr"/></r></p></e>

      <e>       <p><l>fe<b/>fronta<b/>de<s n = "pr"/></l>   <r>devant<s n = "pr"/></r></p></e>
      <e>       <p><l>fe<b/>ruke<b/>de<s n = "pr"/></l>   <r>derrière<s n = "pr"/></r></p></e>
      <e>       <p><l>supra<s n = "pr"/></l>   <r>sur<s n = "pr"/></r></p></e>

      <e>       <p><l>nil<s n = "num"/></l>   <r>zéro<s n = "num"/></r></p></e>
      <e>       <p><l>un<s n = "num"/></l>   <r>un<s n = "num"/></r></p></e>
      <e>       <p><l>dua<s n = "num"/></l>   <r>deux<s n = "num"/></r></p></e>
      <e>       <p><l>tiga<s n = "num"/></l>   <r>trois<s n = "num"/></r></p></e>
      <e>       <p><l>care<s n = "num"/></l>   <r>quatre<s n = "num"/></r></p></e>
      <e>       <p><l>lima<s n = "num"/></l>   <r>cinq<s n = "num"/></r></p></e>
      <e>       <p><l>sisa<s n = "num"/></l>   <r>six<s n = "num"/></r></p></e>
      <e>       <p><l>sabe<s n = "num"/></l>   <r>sept<s n = "num"/></r></p></e>
<e>       <p><l>oco<s n = "num"/></l>   <r>huit<s n = "num"/></r></p></e>
<e>       <p><l>nue<s n = "num"/></l>   <r>neuf<s n = "num"/></r></p></e>
<e>       <p><l>des<s n = "num"/></l>   <r>dix<s n = "num"/></r></p></e>
<e>       <p><l>cen<s n = "num"/></l>   <r>cent<s n = "num"/></r></p></e>
<e>       <p><l>kilo<s n = "num"/></l>   <r>mille<s n = "num"/></r></p></e>

<e r="LR"><p><l>u<s n="vbpr"/></l><r></r></p></e>

<!-- ===== Function words for fra→glb (xwexi Spanish edition vs. French learner grammar) =====
     r="RL" = French→Globasa only, where several French words share one Globasa target. -->

<!-- Subject pronouns. il/elle default to te (ut); anaphora resolution in the rtx switches to to (nt)
     when the antecedent's Globasa gender is nt. Globasa marks sex only for emphasis (xwexi 05). -->
<e r="RL"><p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>je<s n="prn"/></r></p></e>
<e r="LR"><p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>je<s n="prn"/><s n="tn"/><s n="p1"/><s n="mf"/><s n="sg"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>tu<s n="prn"/></r></p></e>
<e r="LR"><p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>tu<s n="prn"/><s n="tn"/><s n="p2"/><s n="mf"/><s n="sg"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="m"/><s n="sg"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="f"/><s n="sg"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="pl"/></l><r>nous<s n="prn"/></r></p></e>
<e r="LR"><p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="pl"/></l><r>nous<s n="prn"/><s n="tn"/><s n="p1"/><s n="mf"/><s n="pl"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="pl"/></l><r>vous<s n="prn"/></r></p></e>
<e r="LR"><p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="pl"/></l><r>vous<s n="prn"/><s n="tn"/><s n="p2"/><s n="mf"/><s n="pl"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="m"/><s n="pl"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="f"/><s n="pl"/></r></p></e>
<!-- glb→fra keeps the gendered forms -->
<e r="LR"><p><l>prpers<s n="prn"/><s n="p3"/><s n="m"/><s n="sg"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="m"/><s n="sg"/></r></p></e>
<e r="LR"><p><l>prpers<s n="prn"/><s n="p3"/><s n="f"/><s n="sg"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="f"/><s n="sg"/></r></p></e>
<e r="LR"><p><l>prpers<s n="prn"/><s n="p3"/><s n="m"/><s n="pl"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="m"/><s n="pl"/></r></p></e>
<e r="LR"><p><l>prpers<s n="prn"/><s n="p3"/><s n="f"/><s n="pl"/></l><r>il<s n="prn"/><s n="tn"/><s n="p3"/><s n="f"/><s n="pl"/></r></p></e>
<!-- on, uno, se impersonal → ren (xwexi 05:39) -->
<e r="RL"><p><l>ren<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>on<s n="prn"/></r></p></e>
<!-- Stressed pronouns -->
<e r="RL"><p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>moi<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>toi<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>lui<s n="prn"/><s n="tn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>eux<s n="prn"/></r></p></e>
<!-- Demonstrative/neuter pronouns → to -->
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>ce<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>ça<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>cela<s n="prn"/></r></p></e>
<e r="RL"><p><l>hin<s n="det"/></l><r>ce<s n="det"/><s n="dem"/></r></p></e>

<!-- Object clitics (<pro>) and imperative enclitics (<enc>); the rtx moves them after the verb
     (xwexi 10:231-247) and puts tas before lui/leur. -->
<e r="RL"><p><l>prpers<s n="prn"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>me<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>te<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>le<s n="prn"/><s n="pro"/><s n="p3"/><s n="nt"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>le<s n="prn"/><s n="enc"/><s n="p3"/><s n="nt"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>le<s n="prn"/><s n="pro"/><s n="p3"/><s n="m"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>le<s n="prn"/><s n="pro"/><s n="p3"/><s n="f"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>le<s n="prn"/><s n="pro"/><s n="p3"/><s n="mf"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>le<s n="prn"/><s n="enc"/><s n="p3"/><s n="m"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>le<s n="prn"/><s n="enc"/><s n="p3"/><s n="f"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>le<s n="prn"/><s n="enc"/><s n="p3"/><s n="mf"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>lui<s n="prn"/><s n="pro"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>leur<s n="prn"/><s n="pro"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>lui<s n="prn"/><s n="enc"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>leur<s n="prn"/><s n="enc"/></r></p></e>
<!-- Reflexive se: the rtx drops it for pronominal verbs (xwexi renders them intransitively). -->
<e r="RL"><p><l>se<s n="prn"/><s n="ref"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>se<s n="prn"/></r></p></e>
<!-- y / en: kept only so the trimmed analyser passes them through; the rtx drops or resolves them. -->
<e r="RL"><p><l>denloka<s n="adv"/></l><r>y<s n="prn"/><s n="pro"/><s n="adv"/></r></p></e>
<e r="RL"><p><l>prpers<s n="prn"/><s n="p3"/><s n="nt"/><s n="sg"/></l><r>en<s n="prn"/><s n="pro"/><s n="adv"/></r></p></e>

<!-- Possessive determiners agree with the possessed noun in French, so owner person/number is
     fixed here from the lemma (mon → misu, notre → imisu). son/sa/ses/leur default to tesu/etesu;
     anaphora switches them to tosu/otosu. -->
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>mon<s n="det"/><s n="pos"/></r></p></e>
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>ton<s n="det"/><s n="pos"/></r></p></e>
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>son<s n="det"/><s n="pos"/></r></p></e>
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p1"/><s n="ut"/><s n="pl"/></l><r>notre<s n="det"/><s n="pos"/></r></p></e>
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p2"/><s n="ut"/><s n="pl"/></l><r>votre<s n="det"/><s n="pos"/></r></p></e>
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p3"/><s n="ut"/><s n="pl"/></l><r>leur<s n="det"/><s n="pos"/></r></p></e>
<e r="LR"><p><l>prpers<s n="det"/><s n="pos"/><s n="p1"/></l><r>mon<s n="det"/><s n="pos"/></r></p></e>
<e r="LR"><p><l>prpers<s n="det"/><s n="pos"/><s n="p2"/></l><r>ton<s n="det"/><s n="pos"/></r></p></e>
<e r="LR"><p><l>prpers<s n="det"/><s n="pos"/><s n="p3"/></l><r>son<s n="det"/><s n="pos"/></r></p></e>
<!-- Possessive pronouns le mien … : the rtx closes the NP with te/to (misu to, xwexi 05:127). -->
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p1"/><s n="ut"/><s n="sg"/></l><r>le<b/>mien<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p2"/><s n="ut"/><s n="sg"/></l><r>le<b/>tien<s n="prn"/></r></p></e>
<e r="RL"><p><l>prpers<s n="det"/><s n="pos"/><s n="p3"/><s n="ut"/><s n="sg"/></l><r>le<b/>sien<s n="prn"/></r></p></e>
